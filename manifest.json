{
  "manifest_version": 3,
  "name": "Better Cinema Mode for YouTube™",
  "version": "1.2.0",
  "description": "Masquez la barre de navigation YouTube en mode cinéma et réaffichez-la d'un clic grâce à un bouton intégré au lecteur.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
